{
  "name": "frame-offline",
  "version": "0.1.0",
  "private": true,
  "description": "Frame — a personal desktop video space",
  "author": "Frame contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "test": "npm run build:electron && vitest run",
    "test:ui": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:library": "node scripts/library-smoke.mjs",
    "test:playback": "node scripts/playback-smoke.mjs",
    "test:youtube": "node scripts/youtube-smoke.mjs",
    "test:organization": "node scripts/organization-smoke.mjs",
    "test:downloads": "node scripts/downloads-smoke.mjs",
    "verify:runtime": "powershell.exe -NoProfile -File scripts/verify-runtime.ps1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.10.2",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "app.frame.offline",
    "productName": "Frame",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "productName": "Frame"
}
